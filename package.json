{
  "name": "yara",
  "version": "0.1.0-poc.1",
  "description": "MeshChat-compatible Rust Reticulum proof of concept",
  "author": "FreeTAKTeam",
  "main": "electron/main.js",
  "scripts": {
    "watch": "npm run build-frontend -- --watch",
    "build-frontend": "vite build",
    "test:launcher": "node --test electron/rust-poc-launcher.test.js",
    "build-backend": "python setup.py build",
    "build": "npm run build-frontend && npm run build-backend",
    "electron-postinstall": "electron-builder install-app-deps",
    "electron": "npm run electron-postinstall && npm run build && electron .",
    "electron:rust-poc": "npm run build-frontend && MESHCHAT_RUST_POC=1 electron .",
    "dist:rust": "npm run build-frontend && electron-builder --publish=never",
    "dist": "npm run electron-postinstall && npm run build && electron-builder --publish=never"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.freetakteam.yara",
    "productName": "YARA",
    "asar": true,
    "files": [
      "electron/**/*",
      "!electron/*.test.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      },
      {
        "from": "build/rust",
        "to": "bin"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "directories": {
      "buildResources": "electron/build"
    },
    "mac": {
      "target": "zip",
      "identity": null,
      "artifactName": "YARA-${version}-macos-${arch}.${ext}"
    },
    "win": {
      "artifactName": "YARA-${version}-windows-${arch}.${ext}",
      "target": "portable"
    },
    "linux": {
      "artifactName": "YARA-${version}-linux-${arch}.${ext}",
      "target": "AppImage",
      "category": "Network"
    }
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@tailwindcss/forms": "^0.5.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "axios": "^1.10.0",
    "click-outside-vue3": "^4.0.1",
    "compressorjs": "^1.2.1",
    "electron-prompt": "^1.7.0",
    "micron-parser": "^1.0.2",
    "mitt": "^3.0.1",
    "moment": "^2.30.1",
    "postcss": "^8.4.49",
    "protobufjs": "^7.4.0",
    "tailwindcss": "^3.4.17",
    "vis-data": "^7.1.9",
    "vis-network": "^9.1.9",
    "vite": "^6.0.5",
    "vite-plugin-vuetify": "^2.0.4",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.6"
  }
}
