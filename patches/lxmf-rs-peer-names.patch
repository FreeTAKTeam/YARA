index 4b2dbcea..b21020d3 100644
--- a/crates/libs/meshchat-api/src/tests.rs
+++ b/crates/libs/meshchat-api/src/tests.rs
@@ -458,3 +458,43 @@ async fn conversation_history_uses_stable_numeric_cursor_for_older_messages() {
     assert_eq!(next_page["lxmf_messages"][0]["content"], "first");
     assert!(next_page["lxmf_messages"][0]["id"].as_i64().expect("row id") < cursor);
 }
+
+#[tokio::test]
+async fn peer_display_names_survive_the_peer_going_offline() {
+    let daemon = Arc::new(RpcDaemon::test_instance());
+    let destination = "00112233445566778899aabbccddeeff";
+    let app = router(Arc::clone(&daemon), None);
+    let (status, _) = call(
+        app.clone(),
+        "POST",
+        "/api/v1/lxmf-messages/send",
+        Some(json!({
+            "delivery_method":null,
+            "lxmf_message":{"destination_hash":destination,"content":"hello"}
+        })),
+    )
+    .await;
+    assert_eq!(status, StatusCode::OK);
+    daemon
+        .accept_announce_with_details(destination.into(), 1, Some("Alice".into()), None)
+        .expect("announce");
+    let (_, listed) = call(app.clone(), "GET", "/api/v1/lxmf/conversations", None).await;
+    assert_eq!(listed["conversations"][0]["display_name"], "Alice");
+
+    // The peer's announce and live record are gone, then it reappears without a name.
+    daemon
+        .handle_rpc(RpcRequest { id: 1, method: "clear_peers".into(), params: None })
+        .expect("clear peers");
+    daemon.accept_announce(destination.into(), 2).expect("nameless announce");
+    let (_, listed) = call(app, "GET", "/api/v1/lxmf/conversations", None).await;
+    assert_eq!(listed["conversations"][0]["display_name"], "Alice");
+}
+
+#[test]
+fn local_state_without_peer_names_still_loads() {
+    let state: LocalState = serde_json::from_value(json!({
+        "config":{},"favourites":{},"display_names":{},"read_at":{}
+    }))
+    .expect("older state file");
+    assert!(state.peer_names.is_empty());
+}
