diff --git a/crates/libs/meshchat-api/src/lib.rs b/crates/libs/meshchat-api/src/lib.rs
index 514c5bd4..4cb73491 100644
--- a/crates/libs/meshchat-api/src/lib.rs
+++ b/crates/libs/meshchat-api/src/lib.rs
@@ -37,6 +37,33 @@ struct LocalState {
     favourites: HashMap<String, Value>,
     display_names: HashMap<String, String>,
     read_at: HashMap<String, i64>,
+    /// Last name each peer announced, kept so contacts stay named while offline.
+    #[serde(default)]
+    peer_names: HashMap<String, String>,
+}
+
+impl LocalState {
+    /// Records a peer's announced name; returns whether the stored state changed.
+    fn remember_peer_name(&mut self, destination: &str, name: Option<&str>) -> bool {
+        let destination = destination.trim().to_ascii_lowercase();
+        let Some(name) = name
+            .map(str::trim)
+            .filter(|name| !name.is_empty() && !name.eq_ignore_ascii_case(&destination))
+        else {
+            return false;
+        };
+        if destination.is_empty()
+            || self.peer_names.get(&destination).map(String::as_str) == Some(name)
+        {
+            return false;
+        }
+        self.peer_names.insert(destination, name.to_owned());
+        true
+    }
+
+    fn peer_name(&self, destination: &str) -> Option<&str> {
+        self.peer_names.get(&destination.trim().to_ascii_lowercase()).map(String::as_str)
+    }
 }
 
